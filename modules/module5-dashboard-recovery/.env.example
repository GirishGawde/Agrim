# Module 5: Authority Dashboard & Recovery
# Copy this file to .env and fill in values.
# Never commit the .env file — it may contain real API keys.

# Set to true to use mock API (no backend needed)
VITE_USE_MOCK=true

# Base URL of the Module 2 FastAPI backend
# Change to your deployed URL for production
VITE_API_BASE_URL=http://localhost:8000

# Optional: Supabase realtime (Module 2 will provide these)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
